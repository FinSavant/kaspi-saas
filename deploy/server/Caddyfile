# Кабинет закрыт паролем: входа пользователей в приложении пока нет.
# Когда появится домен, замените «:80» на него — Caddy сам получит HTTPS-сертификат.
:80 {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	# Читатель цен с компьютера продавца обращается к api напрямую (api ещё проверяет x-api-key)
	handle_path /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
