# Шаблон. Настоящий файл: /etc/sanq/price-reader.env (владелец root, права 600).
# В репозиторий настоящие значения не попадают.
# Адрес сервера SANQ (как в .env на компьютере) и данные доступа
SERVER_URL=https://sanq.kz
SERVER_AUTH=логин:пароль
API_INTERNAL_KEY=
# Необязательно
# STOREFRONT_MIN_INTERVAL_MS=1000
# Паузы при ответе Kaspi 405, минуты (последнее число — потолок)
# BLOCKED_PAUSES_MIN=5,10,20,40,60
# Через сколько 405 подряд остановить опрос
# BLOCKED_MAX_CYCLES=6
