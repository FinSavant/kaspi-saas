generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Все денежные суммы хранятся в целых тенге.

model User {
  id             String   @id @default(cuid())
  // Вход по email и паролю; phone — старый служебный идентификатор (local-owner)
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String
  name           String?
  telegramChatId String?  @unique
  // Владелец платформы: без ограничений тарифа, видит админку и скрытые разделы
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shops        Shop[]
  subscription Subscription?
  sessions     Session[]
  wbAccount WbAccount?
}

// Сессия входа в веб-кабинет. В куке браузера — сам токен, здесь — только его SHA-256
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Shop {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  merchantId  String   @unique
  // API-токен Kaspi, зашифрованный AES-256-GCM (см. @kaspi/core encryptSecret)
  apiTokenEnc String
  // Город, по которому смотрим цены конкурентов (код Kaspi, по умолчанию Алматы)
  cityId      String   @default("750000000")
  // Общая пауза репрайсера по магазину; выбор по товарам при этом не меняется
  repricerEnabled Boolean @default(true)
  // Куки сессии кабинета продавца (kaspi.kz/mc), зашифрованные как apiTokenEnc.
  // Нужны для синхронизации товаров в продаже
  mcSessionEnc    String?
  // Логин и пароль пользователя кабинета Kaspi этого магазина, зашифрованные.
  // Нужны воркеру, чтобы входить заново, когда сессия истекла
  mcLoginEnc      String?
  mcPasswordEnc   String?
  // Кабинет подключён входом по номеру телефона (10 цифр): пароля нет, при истёкшей
  // сессии продавец входит заново по SMS
  mcPhone         String?
  // Сессия входа в кабинет по номеру телефона — только она даёт доступ к чату с
  // покупателями (сообщения о заказе, просьба об отзыве). Зашифрована, как mcSessionEnc
  chatSessionEnc  String?
  chatPhone       String?
  // Отзывы: сообщения покупателям в чат Kaspi (приветствие и просьба об отзыве)
  reviewsEnabled     Boolean   @default(false)
  // С какого момента рассылка включена: старые заказы не трогаем
  reviewsEnabledAt   DateTime?
  reviewHoursFrom    Int       @default(8)
  reviewHoursTo      Int       @default(23)
  // Через сколько часов после выдачи просить отзыв
  reviewDelayHours   Int       @default(0)
  newOrderMessages   Boolean   @default(true)
  reviewMessages     Boolean   @default(true)
  // null — шаблон по умолчанию (@kaspi/core reviews)
  newOrderTemplate   String?
  reviewTemplate     String?
  reviewMessagesLog  ReviewMessage[]
  // Агент-ответчик в чате Kaspi: отвечает покупателям сам, сложное передаёт владельцу в Telegram
  chatAgentEnabled   Boolean   @default(false)
  // С какого момента агент включён: старые сообщения не трогаем
  chatAgentEnabledAt DateTime?
  chatAgentReplies   ChatAgentReply[]
  chatEscalations    ChatEscalation[]
  chatKnowledge      ChatKnowledge[]
  productsSyncedAt DateTime?
  ordersSyncedAt   DateTime?
  // Удержания Kaspi для аналитики: НДС на комиссию Магазина и комиссия Kaspi Pay, %
  commissionVatPercent Decimal @default(16) @db.Decimal(5, 2)
  paymentFeePercent    Decimal @default(0.95) @db.Decimal(5, 2)
  // Налог продавца от выручки (упрощённая декларация), %; 0 — не учитывать
  taxPercent           Decimal @default(0) @db.Decimal(5, 2)
  // Свои расходы продавца от выручки для аналитики: [{ name, percent }], до 4 строк
  customExpenses       Json    @default("[]")
  // Варианты наценки для «Мин. цены» на вкладке робота: прибыль 5% и 10% от цены и т. п.
  markupPercents       Int[]   @default([5, 10])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products        Product[]
  orders          Order[]
  waybillBatches  WaybillBatch[]
  printedWaybills PrintedWaybill[]

  pickingMarks    PickingMark[]
  @@index([ownerId])
}

// Подписка продавца SANQ (одна на аккаунт, охватывает все его магазины).
// Статус считается по датам (@kaspi/core subscriptionState): оплачено до paidUntil
// или идёт пробный период до trialEndsAt; иначе доступ закрыт, данные остаются.
model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique
  // start | pro | business (@kaspi/core PLANS)
  plan         String    @default("start")
  // Доплата за отзывы к тарифу «Старт»
  reviewsAddon Boolean   @default(false)
  trialEndsAt  DateTime?
  paidUntil    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id        String   @id @default(cuid())
  shopId    String
  kaspiSku  String
  // Код общей карточки товара на Kaspi (число в конце ссылки на карточку);
  // без него репрайсер не может получить цены конкурентов
  kaspiMasterSku String?
  // Сколько продавцов в карточке, включая нас, по последней проверке.
  // Больше одного — «открытая» карточка с конкурентами
  sellersCount Int?
  name      String
  brand     String?
  category  String?
  price     Int
  // Себестоимость единицы; без неё прибыль и ROI не считаются
  costPrice Int?
  stock     Int      @default(0)
  available Boolean  @default(true)
  // Настройка: товар держится на предзаказе столько дней; null — не ставить
  preorderDays Int?
  // Сейчас в Kaspi: дней предзаказа (из кабинета); null — не на предзаказе
  preOrder     Int?
  // Фото и карточка на витрине kaspi.kz — из кабинета при синхронизации товаров
  imageUrl     String?
  shopUrl      String?
  // Склады из кабинета: [{ storeId, available, stockCount, preOrder }] (StoreState)
  stores       Json?
  // Вес, кг — для тарифа доставки заказов от 10 000 ₸. Из карточки Kaspi или вручную
  // (weightManual — тогда синхронизация его не перезаписывает)
  weightKg     Float?
  weightManual Boolean  @default(false)
  // Описание и характеристики из карточки Kaspi (GET /bff/offer-view/details) — для ответов агента в чате
  description     String?
  specifications  Json?
  contentSyncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repricerSetting RepricerSetting?
  competitorLogs  CompetitorLog[]
  priceChanges    PriceChange[]
  orderItems      OrderItem[]

  @@unique([shopId, kaspiSku])
}

model RepricerSetting {
  id               String    @id @default(cuid())
  productId        String    @unique
  enabled          Boolean   @default(false)
  // Ниже этой цены бот не опускается никогда
  floorPrice       Int
  // Выше этой цены бот не поднимается; если не задана, бот цену не повышает
  ceilingPrice     Int?
  step             Int       @default(1)
  checkIntervalSec Int       @default(300)
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([enabled, lastCheckedAt])
}

model CompetitorLog {
  id           BigInt   @id @default(autoincrement())
  productId    String
  merchantId   String
  merchantName String?
  price        Int
  position     Int?
  capturedAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

model PriceChange {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Int
  newPrice  Int
  reason    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model Order {
  id             String   @id @default(cuid())
  shopId         String
  kaspiOrderId   String
  code           String
  // state и status приходят от Kaspi строками (NEW, KASPI_DELIVERY, ARCHIVE, ...)
  state          String
  status         String
  totalPrice     Int
  // Доставка, которую Kaspi удерживает с продавца (deliveryCostForSeller)
  deliveryCost   Int       @default(0)
  city           String?
  waybillUrl     String?
  createdAtKaspi DateTime
  completedAt    DateTime?
  // Когда заказ передан курьеру Kaspi Доставки — для среднего времени обработки
  courierTransmissionDate DateTime?
  deliveryMode    String?
  paymentMode     String?
  isKaspiDelivery Boolean   @default(false)
  express         Boolean   @default(false)
  // Для сообщений покупателю в чат Kaspi
  customerName        String?
  plannedDeliveryDate DateTime?
  syncedAt       DateTime  @default(now())
  // Когда загружены позиции заказа; null — ещё не загружены
  itemsSyncedAt  DateTime?

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([shopId, code])
  @@index([shopId, createdAtKaspi])
  @@index([shopId, state])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  kaspiSku  String
  name      String
  // Код категории Kaspi, например "Master - Hair care products"
  category  String?
  categoryTitle String?
  quantity  Int
  unitPrice Int
  totalPrice Int    @default(0)
  // Себестоимость на момент продажи; если не задана, берётся из товара
  costPrice Int?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// Сообщение покупателю в чат Kaspi по заказу: одно на заказ и вид — защита от повторов
model ReviewMessage {
  id        String    @id @default(cuid())
  shopId    String
  orderCode String
  // NEW_ORDER — приветствие после заказа, REVIEW — просьба об отзыве после выдачи
  kind      String
  // SENT, FAILED, NO_CHAT (у заказа нет диалога), REJECTED (Kaspi не пропустил текст)
  status    String
  groupId   String?
  error     String?
  sentAt    DateTime  @default(now())
  // Покупатель ответил после нашего сообщения
  repliedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderCode, kind])
  @@index([shopId, sentAt])
}

// Комиссия Kaspi по категории без НДС, %. Kaspi API её не отдаёт — ставки из
// официальной таблицы «Тарифы Магазина на Kaspi.kz» или вводит продавец
model CategoryCommission {
  id        String   @id @default(cuid())
  category  String   @unique
  title     String?
  percent   Decimal  @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt
}

enum WaybillLayout {
  THERMAL
  A4_X4
  A4_X8
}

model WaybillBatch {
  id          String        @id @default(cuid())
  shopId      String
  layout      WaybillLayout
  storagePath String
  count       Int
  createdAt   DateTime      @default(now())

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  waybills PrintedWaybill[]

  @@index([shopId, createdAt])
}

model PrintedWaybill {
  id        String   @id @default(cuid())
  shopId    String
  orderCode String
  // Склейки хранятся сутки; отметка «напечатано» остаётся и после удаления склейки
  batchId   String?
  printedAt DateTime @default(now())

  shop  Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batch WaybillBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Защита от повторной печати
  @@unique([shopId, orderCode])
}


// Отметки экрана «Сборка»: позиция заказа собрана / упакована (по заказу и артикулу)
model PickingMark {
  id        String   @id @default(cuid())
  shopId    String
  orderCode String
  sku       String
  collected Boolean  @default(false)
  packed    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderCode, sku])
}

// Кабинет продавца Wildberries: токен API (категория «Статистика», только чтение)
model WbAccount {
  id         String    @id @default(cuid())
  ownerId    String    @unique
  // Токен, зашифрованный как apiTokenEnc у магазинов Kaspi
  tokenEnc   String
  // Налог продавца от выручки, %
  taxPercent Decimal   @default(0) @db.Decimal(5, 2)
  syncedAt   DateTime?
  syncError  String?
  createdAt  DateTime  @default(now())

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rows     WbReportRow[]
  products WbProduct[]
  reports  WbReport[]
}

// Еженедельный отчёт о реализации WB: загружен файлом из кабинета или пришёл через API.
// Строки отчёта — WbReportRow с тем же realizationreportId; файл заменяет строки из API
model WbReport {
  id         String    @id @default(cuid())
  accountId  String
  reportId   BigInt
  dateFrom   DateTime?
  dateTo     DateTime?
  // file | api
  source     String
  fileName   String?
  rowsCount  Int       @default(0)
  uploadedAt DateTime  @default(now())

  account WbAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, reportId])
}

// Строка «Отчёта о реализации» WB (reportDetailByPeriod); суммы — в валюте отчёта
model WbReportRow {
  id          String   @id @default(cuid())
  accountId   String
  rrdId       BigInt
  realizationreportId BigInt?
  nmId        BigInt?
  saName      String?
  brand       String?
  subject     String?
  title       String?
  docType     String?
  operName    String?
  quantity    Int      @default(0)
  retailAmount Float   @default(0)
  forPay      Float    @default(0)
  delivery    Float    @default(0)
  storage     Float    @default(0)
  penalty     Float    @default(0)
  acceptance  Float    @default(0)
  deduction   Float    @default(0)
  additionalPayment Float @default(0)
  currency    String?
  saleDate    DateTime?
  rrDate      DateTime?

  // Склад и способ продажи (FBS / FBW) — для разбивки логистики
  warehouse   String?
  saleMethod  String?

  account WbAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, rrdId])
  @@index([accountId, realizationreportId])
  @@index([accountId, saleDate])
}

// Товар WB: себестоимость вводится вручную
model WbProduct {
  id        String  @id @default(cuid())
  accountId String
  nmId      BigInt
  saName    String?
  title     String?
  costPrice Float?

  account WbAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, nmId])
}

// Обработанные агентом сообщения покупателей: уникальный ключ не даёт ответить дважды
model ChatAgentReply {
  id        String   @id @default(cuid())
  shopId    String
  groupId   String
  // id сообщения покупателя, на которое отвечали
  messageId String
  // ANSWERED — по существу, GREETING — приветствие, HOLDING — «уточню» + вопрос владельцу,
  // SKIPPED — отвечать не стали (лимит, нет текста), DELIVERED — ответ владельца ушёл покупателю
  kind      String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, messageId])
  @@index([shopId, groupId, createdAt])
}

// Вопрос, который агент не смог закрыть сам: ушёл владельцу в Telegram, ждёт ответа реплаем
model ChatEscalation {
  id             String    @id @default(cuid())
  shopId         String
  groupId        String
  messageId      String
  // Вопрос покупателя (последние сообщения подряд) и товар, по которому он
  question       String
  masterSku      String?
  productName    String?
  // Куда отправили владельцу: ответ реплаем на это сообщение
  telegramChatId String?
  telegramMsgId  String?
  // PENDING — ждёт ответа, ANSWERED — ответ получен, DELIVERED — ушёл покупателю, FAILED — не удалось отправить
  status         String    @default("PENDING")
  answer         String?
  error          String?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, messageId])
  @@index([telegramChatId, telegramMsgId])
  @@index([shopId, status])
}

// Память агента: ответы владельца на вопросы покупателей, их агент использует в следующий раз
model ChatKnowledge {
  id         String   @id @default(cuid())
  shopId     String
  question   String
  answer     String
  // Если ответ про конкретный товар — его masterSku; null — для всех товаров магазина
  masterSku  String?
  productName String?
  uses       Int      @default(0)
  // Владелец может отключить запись, если ответ устарел
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, active])
}
