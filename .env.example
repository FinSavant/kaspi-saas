# PostgreSQL и Redis (значения совпадают с docker-compose.yml)
DATABASE_URL=postgresql://kaspi:kaspi@localhost:5432/kaspi?schema=public
REDIS_URL=redis://localhost:6379

# Ключ шифрования API-токенов Kaspi: 32 байта в hex (64 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# API-токен магазина из кабинета Kaspi (Настройки → Токен API).
# Нужен только для проверки подключения: npm run check:kaspi
KASPI_API_TOKEN=

# Общий секрет между web/bot и api (заголовок x-api-key)
API_INTERNAL_KEY=
API_PORT=4000
API_URL=http://localhost:4000

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=

# Репрайсер: cabinet — менять цены в кабинете Kaspi; пусто — только считать в базе.
REPRICER_PUBLISH=
# Репрайсер: пауза между запросами к витрине Kaspi, мс.
# COMPETITOR_SOURCE=mock отключает запросы к витрине.
STOREFRONT_MIN_INTERVAL_MS=1000
COMPETITOR_SOURCE=

# Хранилище PDF: если GCS_BUCKET пуст, файлы пишутся в LOCAL_STORAGE_DIR
GCS_BUCKET=
LOCAL_STORAGE_DIR=./storage

# Отдельный пользователь кабинета Kaspi только с правом «Загрузка товаров».
# Нужен для синхронизации товаров в продаже.
KASPI_MC_LOGIN=
KASPI_MC_PASSWORD=


# Номер WhatsApp для оплаты тарифов SANQ (только цифры)
SANQ_WHATSAPP=
